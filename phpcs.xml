<?xml version="1.0"?>
<ruleset name="Tosuto">
	<description>PHP Coding Standards for this project</description>

	<file>./wp-tosuto.php</file>
	<file>./sources/</file>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="Syde"/>

	<!--
		The Api/functions.php file intentionally declares global functions
		(wp_tosuto, wp_tosuto_remove) as public API entry points for plugin consumers.
	-->
	<rule ref="Syde.Functions.DisallowGlobalFunction">
		<exclude-pattern>sources/server/Api/functions.php</exclude-pattern>
	</rule>

	<!--
		Syde enforces camelCase for variable names, but WordPress convention uses snake_case.
		Prefer WordPress naming conventions for variables.
	-->
	<rule ref="Syde.NamingConventions.VariableName">
		<exclude name="Syde.NamingConventions.VariableName.SnakeCaseVar"/>
	</rule>
</ruleset>
